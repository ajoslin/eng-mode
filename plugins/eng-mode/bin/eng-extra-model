#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PATH="${PATH:+$PATH:}$HOME/.local/bin:$HOME/.bun/bin:${BUN_INSTALL:-$HOME/.bun}/bin:/opt/homebrew/bin:/usr/local/bin"
export PATH
command -v bun >/dev/null 2>&1 || { echo "eng-extra-model: bun not found on PATH or in its usual install locations" >&2; exit 127; }
exec bun "$root/lib/extra-model.ts" "$@"
